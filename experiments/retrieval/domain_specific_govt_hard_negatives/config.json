{
  "experiment_name": "domain_specific_govt_hard_negatives",
  "domain": "govt",
  "base_model": "BAAI/bge-base-en-v1.5",
  "use_pretrained_multi_domain": true,
  "pretrained_multi_domain_path": "./models/baseline_5_epochs",
  "epochs": 5,
  "batch_size": 32,
  "learning_rate": 2e-05,
  "num_hard_negatives": 3,
  "loss_function": "CosineSimilarityLoss",
  "use_validation": true,
  "use_data_splits": true,
  "warmup_steps": 100,
  "evaluation_steps": 200,
  "save_best_model": true,
  "save_checkpoints": true,
  "checkpoint_steps": 1000,
  "seed": 42,
  "output_path": "./models/domain_specific_govt_hard_negatives"
}