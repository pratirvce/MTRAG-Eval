% NeurIPS 2024 LaTeX style file

% This style file is a simplified version for NeurIPS-style formatting
% For official submission, use the official NeurIPS template

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{neurips_2024}[2024/01/01 NeurIPS style file]

% Page geometry
\RequirePackage[letterpaper, margin=1in]{geometry}

% Font settings
\RequirePackage{times}
\RequirePackage{helvet}
\RequirePackage{courier}

% Math packages
\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{amsthm}

% Bibliography
\RequirePackage{natbib}
\bibliographystyle{plainnat}

% Hyperref
\RequirePackage{hyperref}
\hypersetup{
    colorlinks=true,
    linkcolor=black,
    citecolor=black,
    urlcolor=black
}

% Title formatting
\renewcommand{\maketitle}{%
  \twocolumn[%
    \begin{@twocolumnfalse}%
      \vspace{-1in}%
      \begin{center}%
        {\Large\bfseries \@title \par}%
        \vspace{0.3cm}%
        {\large \@author \par}%
        \vspace{0.3cm}%
        \begin{abstract}%
          \noindent
        \end{abstract}%
      \end{center}%
      \vspace{0.5cm}%
    \end{@twocolumnfalse}%
  ]%
}

% Two column layout
\twocolumn

% Section formatting
\renewcommand{\section}{\@startsection{section}{1}{\z@}%
  {-1.5ex \@plus -1ex \@minus -.2ex}%
  {1.3ex \@plus.2ex}%
  {\normalfont\large\bfseries}}

\renewcommand{\subsection}{\@startsection{subsection}{2}{\z@}%
  {-1.25ex\@plus -1ex \@minus -.2ex}%
  {.8ex \@plus .2ex}%
  {\normalfont\normalsize\bfseries}}

\renewcommand{\subsubsection}{\@startsection{subsubsection}{3}{\z@}%
  {-1.25ex\@plus -1ex \@minus -.2ex}%
  {.5ex \@plus .2ex}%
  {\normalfont\normalsize\itshape}}

\endinput

